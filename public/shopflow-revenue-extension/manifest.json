{
  "manifest_version": 3,
  "name": "ShopFlow · Trợ Lý Bán Hàng & Nhân Bản Shopee",
  "version": "1.2.9",
  "description": "Đọc doanh số thực nhận Shopee, gộp đơn 3 tab, nhân bản sản phẩm lách AI chống quét trùng lặp và tự động điền form thêm sản phẩm shop vệ tinh.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://banhang.shopee.vn/*",
    "https://down-vn.img.susercontent.com/*",
    "https://cf.shopee.vn/*",
    "https://shopflow-2zbb.onrender.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShopFlow · Trợ Lý Shopee"
  },
  "content_scripts": [
    {
      "matches": [
        "https://banhang.shopee.vn/*"
      ],
      "js": [
        "injected-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*"
      ],
      "js": [
        "finance-parser.js",
        "parser.js",
        "product-cloner.js",
        "image-processor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shopflow-2zbb.onrender.com/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "https://shopflow-dong-hang-thaiz.thaizzbbl.chatgpt.site/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected-hook.js",
        "parser.js",
        "product-cloner.js",
        "image-processor.js",
        "finance-parser.js"
      ],
      "matches": [
        "https://banhang.shopee.vn/*"
      ]
    }
  ]
}
