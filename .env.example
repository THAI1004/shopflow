NODE_ENV=production
APP_ORIGIN=https://shop.example.com
PORT=3000
HOST=127.0.0.1
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
ALLOW_REGISTRATION=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_shopflow
DB_USER=cpaneluser_shopflow
DB_PASSWORD=
STORAGE_DIR=./storage
TRUST_PROXY_HOPS=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this path under your own domain: /api/drive/callback

# Aiven: TLS with certificate validation. Paste the content of ca.pem in DB_SSL_CA.
DB_SSL=false
DB_SSL_CA=
# Render ephemeral disk: keep client video until Drive confirms upload.
REQUIRE_DRIVE_BEFORE_ACK=false
